{
  "name": "sgs-templater-mcr-web",
  "version": "1.0.0",
  "description": "A base project for restful api generated by SGS Templater",
  "main": "index.js",
  "scripts": {
    "start": "infisical run --env=prod --path=/monolithic-setup -- node server.js",
    "dev": "infisical run --env=dev --path=/monolithic-setup -- nodemon server.js",
    "test": "jest --runInBand --detectOpenHandles --watchAll",
    "uat": "infisical run --env=staging --path=/monolithic-setup -- nodemon server.js"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testPathIgnorePatterns": [
      "<rootDir>/src/tests/examples.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/tests/setup/setup-jest.js"
    ],
    "testTimeout": 100000,
    "forceExit": true
  },
  "author": "Special Man Global Solution LTD",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.354.0",
    "@aws-sdk/lib-storage": "^3.445.0",
    "@joi/date": "^2.1.0",
    "app-root-path": "^3.0.0",
    "axios": "^1.3.4",
    "bcrypt": "^5.0.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^8.6.0",
    "express": "^4.17.1",
    "express-mongo-sanitize": "^2.2.0",
    "firebase-admin": "^11.7.0",
    "joi": "^17.4.0",
    "json2csv": "^5.0.6",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "moment": "^2.29.4",
    "mongodb-memory-server": "^9.1.6",
    "mongoose": "^5.12.4",
    "mongoose-sequence": "^5.3.1",
    "morgan-body": "^2.6.5",
    "multer": "^1.4.2",
    "newrelic": "^10.1.0",
    "nodemailer": "^6.8.0",
    "nodemon": "^3.1.0",
    "randomstring": "^1.2.3",
    "redis": "^4.7.0",
    "sib-api-v3-sdk": "^8.4.2",
    "valid-url": "^1.0.9",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "install": "^0.13.0",
    "jest": "^29.6.2",
    "npm": "^8.19.2",
    "supertest": "^6.1.3",
    "ts-jest": "^29.1.1"
  }
}
